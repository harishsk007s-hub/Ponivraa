# ==============================================================================
# Ponivraa Backend Production Environment Variables Example
# Duplicate this file as .env and fill in real production secrets.
# NEVER commit .env with real credentials to GitHub.
# ==============================================================================

# Server Port (Render automatically sets PORT in production)
PORT=5000

# Environment Mode: production | development
NODE_ENV=production

# MongoDB Atlas Connection String
# e.g. mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/ponivraa?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key (generate a strong random 64-character string)
JWT_SECRET=

# Primary Admin Account Credentials (used for initial admin setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Allowed Client / Frontend URLs for CORS (e.g. https://ponivraa.vercel.app)
# Comma-separated if multiple domains are used.
CLIENT_URL=

# Cloudinary Storage Credentials for Product Image Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
