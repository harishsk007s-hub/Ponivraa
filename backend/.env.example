# Ponivraa Backend Environment Variables

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ponivraa?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key
